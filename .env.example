# Public URL of the deployed site (no trailing slash). Used for metadata, OG image and sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Resend (https://resend.com) API key used by /api/contact to deliver form submissions.
RESEND_API_KEY=re_xxxxxxxxx

# Inbox that receives contact form messages.
CONTACT_TO_EMAIL=hamzaazam994@gmail.com

# Sender address. Must be on a domain verified in Resend, or use onboarding@resend.dev for testing.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
